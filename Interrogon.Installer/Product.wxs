<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- Product identity. Version: passed in via the ProductVersion preprocessor variable
       (-p:DefineConstants=ProductVersion=... on `dotnet build`) by build-installer.bat, which
       reads it straight out of Interrogon.App.csproj's <Version> — that csproj value is the
       single source of truth, never edited here. UpgradeCode: set once, NEVER change after the
       first real release — this is how Windows Installer recognizes a new MSI as an upgrade of
       this product rather than a separate app. -->
  <Package
    Name="Interrogon"
    Manufacturer="Andreas Gkesos"
    Version="$(var.ProductVersion)"
    UpgradeCode="c240026b-c027-408b-a87b-2ecf939c52d5"
    Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Interrogon is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Install-time options, settable via the UI or command line (e.g. msiexec /i ... DELETE_USER_DATA=1). -->
    <Property Id="DELETE_USER_DATA" Value="0" Secure="yes" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />

    <!-- Where things get installed: Program Files\Interrogon\ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Interrogon" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Interrogon" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- File payload, auto-harvested from the staging folder build-installer.bat produces —
         no per-file GUIDs to manage by hand; WiX generates stable component IDs from the file
         list as long as the folder shape doesn't change unexpectedly. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="staging\App\**\*.*" />
    </ComponentGroup>

    <!-- Start Menu shortcut — always installed. Guid: set once, never change after shipping;
         changing it later makes Windows Installer treat it as a different component and can
         orphan the old shortcut on upgrade. -->
    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="3ea1cc65-2789-41b3-b488-ac8529b6b872">
      <Shortcut
        Id="StartMenuShortcutFile"
        Name="Interrogon"
        Target="[INSTALLFOLDER]Interrogon.exe"
        WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue
        Root="HKCU"
        Key="Software\Interrogon"
        Name="StartMenuShortcutInstalled"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <!-- Desktop shortcut — optional, controlled by INSTALLDESKTOPSHORTCUT (checked/on by
         default). Same GUID-stability rule as above. -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="1d3c5040-2dd2-43c5-bd97-53eee136a239" Condition="INSTALLDESKTOPSHORTCUT = &quot;1&quot;">
      <Shortcut
        Id="DesktopShortcutFile"
        Name="Interrogon"
        Target="[INSTALLFOLDER]Interrogon.exe"
        WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue
        Root="HKCU"
        Key="Software\Interrogon"
        Name="DesktopShortcutInstalled"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <!-- Deletes %LOCALAPPDATA%\Interrogon (interrogon.db and related files) on a true uninstall,
         only when the user opted in via DELETE_USER_DATA. Never fires on upgrade/repair.
         Same GUID-stability rule as the shortcuts above. -->
    <Component Id="DeleteUserData" Directory="INSTALLFOLDER" Guid="e9f6c1a2-5b3d-4e7f-8a9c-1d2e3f4a5b6c" Condition="DELETE_USER_DATA = &quot;1&quot;">
      <util:RemoveFolderEx Id="RemoveUserDataFolder" Property="LOCALAPPDATADIR" On="uninstall" />
      <RegistryValue
        Root="HKCU"
        Key="Software\Interrogon"
        Name="DeleteUserDataRegistered"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <SetProperty Id="LOCALAPPDATADIR" Value="[LocalAppDataFolder]Interrogon" After="AppSearch" Sequence="both" />

    <!-- Ties everything above together into the one installable feature. -->
    <Feature Id="MainFeature" Title="Interrogon" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="DeleteUserData" />
    </Feature>

    <!-- Standard WiX install-directory-picker UI. -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

  </Package>
</Wix>
